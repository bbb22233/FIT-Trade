{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fit.trade/contracts/platform/remediation-proposal-v1.schema.json",
  "title": "FIT Trade Phase 1 remediation proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "discovery_commit",
    "affected_component",
    "affected_task",
    "severity",
    "reproducible_evidence",
    "path_boundary",
    "proposed_owner",
    "exact_base",
    "acceptance_checks",
    "compatibility_impact",
    "rollback_impact",
    "unresolved_risks",
    "authorization"
  ],
  "properties": {
    "schema_version": {
      "const": "fit.platform.remediation-proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "discovery_commit": {
      "$ref": "#/$defs/GitCommit"
    },
    "affected_component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "affected_task": {
      "type": "string",
      "pattern": "^P1-[0-9]{3}$"
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "reproducible_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "path_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted",
        "forbidden"
      ],
      "properties": {
        "permitted": {
          "$ref": "#/$defs/Paths"
        },
        "forbidden": {
          "$ref": "#/$defs/Paths"
        }
      }
    },
    "proposed_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "exact_base": {
      "$ref": "#/$defs/GitCommit"
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "compatibility_impact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "rollback_impact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "unresolved_risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "authorization": {
      "const": "PROPOSAL_ONLY_NO_EDIT_AUTHORITY"
    }
  },
  "$defs": {
    "GitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "Paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "expected",
        "observed"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "observed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
