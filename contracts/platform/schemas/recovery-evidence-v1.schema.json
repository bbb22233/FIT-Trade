{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fit.trade/contracts/platform/recovery-evidence-v1.schema.json",
  "title": "FIT Trade Phase 1 measured recovery evidence",
  "type": "object",
  "x-fit-recovery-consistency": true,
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "workload",
    "failure",
    "last_committed",
    "last_recovered",
    "observed_rpo",
    "restore",
    "components",
    "verification_gates",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "fit.platform.recovery-evidence.v1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "workload": {
      "$ref": "#/$defs/Workload"
    },
    "failure": {
      "$ref": "#/$defs/Failure"
    },
    "last_committed": {
      "$ref": "#/$defs/SequencePoint"
    },
    "last_recovered": {
      "$ref": "#/$defs/SequencePoint"
    },
    "observed_rpo": {
      "$ref": "#/$defs/ObservedRpo"
    },
    "restore": {
      "$ref": "#/$defs/Restore"
    },
    "observed_rto_ms": {
      "type": "integer",
      "minimum": 0
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Component"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "postgresql"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "recovery-tool"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "verification_gates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Gate"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "constraints"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "aggregate_versions"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "outbox_continuity"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "audit_linkage"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "fixture_checksums"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL_CLOSED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "observed_rto_ms"
        ],
        "properties": {
          "restore": {
            "required": [
              "verification_completed_at",
              "completion_event_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "verification_stopped_at"
                  ]
                },
                {
                  "required": [
                    "stop_event_id"
                  ]
                },
                {
                  "required": [
                    "failure_reason_code"
                  ]
                }
              ]
            }
          },
          "verification_gates": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failure": {
            "properties": {
              "kind": {
                "enum": [
                  "BACKUP_CORRUPTION",
                  "MISSING_WAL",
                  "INCOMPATIBLE_MIGRATION",
                  "PARTIAL_RESTORE",
                  "MISSING_CREDENTIAL",
                  "EXTERNAL_EGRESS"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "failure"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "const": "FAIL_CLOSED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "FAIL_CLOSED"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "not": {
          "required": [
            "observed_rto_ms"
          ]
        },
        "properties": {
          "restore": {
            "required": [
              "verification_stopped_at",
              "stop_event_id",
              "failure_reason_code"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "verification_completed_at"
                  ]
                },
                {
                  "required": [
                    "completion_event_id"
                  ]
                }
              ]
            }
          },
          "verification_gates": {
            "contains": {
              "properties": {
                "status": {
                  "const": "FAIL"
                }
              },
              "required": [
                "status"
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_id",
        "workload_manifest_sha256",
        "fixed_seed",
        "event_rate_per_second",
        "utc_clock_source"
      ],
      "properties": {
        "workload_id": {
          "const": "p1-recovery-synthetic-v1"
        },
        "workload_manifest_sha256": {
          "const": "2258819d69d696992b7f8c0306244bba93e8569a4bff0886ada4d061e7d7ddec"
        },
        "fixed_seed": {
          "const": 20260729
        },
        "event_rate_per_second": {
          "const": 20
        },
        "utc_clock_source": {
          "const": "CLOCK_REALTIME_UTC"
        }
      }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "injected_at",
        "injection_point"
      ],
      "properties": {
        "kind": {
          "enum": [
            "PROCESS_KILL",
            "NETWORK_PARTITION",
            "BACKUP_CORRUPTION",
            "MISSING_WAL",
            "INCOMPATIBLE_MIGRATION",
            "PARTIAL_RESTORE",
            "MISSING_CREDENTIAL",
            "EXTERNAL_EGRESS"
          ]
        },
        "injected_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "injection_point": {
          "const": "AFTER_COMMITTED_SEQUENCE_6000"
        }
      }
    },
    "SequencePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "committed_at"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "committed_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ObservedRpo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_gap",
        "time_gap_ms",
        "calculation"
      ],
      "properties": {
        "sequence_gap": {
          "type": "integer",
          "minimum": 0
        },
        "time_gap_ms": {
          "type": "integer",
          "minimum": 0
        },
        "calculation": {
          "const": "last_committed_minus_last_recovered"
        }
      }
    },
    "Restore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoked_at",
        "start_event_id"
      ],
      "properties": {
        "invoked_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "verification_completed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "start_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "completion_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "verification_stopped_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "stop_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "failure_reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        }
      }
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "artifact_sha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "postgresql",
            "recovery-tool"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "artifact_sha256": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "evidence_sha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "constraints",
            "aggregate_versions",
            "outbox_continuity",
            "audit_linkage",
            "fixture_checksums"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "evidence_sha256": {
          "$ref": "#/$defs/Digest"
        }
      }
    }
  }
}
