    "AuditIntent": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.audit-intent.v1"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/AuditCore"
        },
        {
          "$ref": "#/$defs/AuditScopeRules"
        },
        {
          "$ref": "#/$defs/AuditKindFieldRules"
        }
      ]
    },
    "AuditEvent": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "occurred_at",
        "payload_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.audit-event.v1"
        },
        "event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "occurred_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "payload_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/AuditCore"
        },
        {
          "$ref": "#/$defs/AuditScopeRules"
        },
        {
          "$ref": "#/$defs/AuditKindFieldRules"
        }
      ]
    },
    "AuditScopeRules": {
      "oneOf": [
        {
          "properties": {
            "scope": {
              "$ref": "#/$defs/OwnerScope"
            },
            "trigger": {
              "const": "REQUEST"
            }
          },
          "required": [
            "request_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "security_operation_id"
                ]
              },
              {
                "required": [
                  "system_operation_id"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "scope": {
              "$ref": "#/$defs/AuthSecurityScope"
            },
            "trigger": {
              "const": "REQUEST"
            }
          },
          "required": [
            "request_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "security_operation_id"
                ]
              },
              {
                "required": [
                  "system_operation_id"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "scope": {
              "$ref": "#/$defs/AuthSecurityScope"
            },
            "trigger": {
              "const": "BACKGROUND"
            }
          },
          "required": [
            "security_operation_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "request_id"
                ]
              },
              {
                "required": [
                  "system_operation_id"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "scope": {
              "$ref": "#/$defs/SystemScope"
            },
            "trigger": {
              "const": "BACKGROUND"
            }
          },
          "required": [
            "system_operation_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "request_id"
                ]
              },
              {
                "required": [
                  "security_operation_id"
                ]
              }
            ]
          }
        }
      ]
    },
    "AuditKindFieldRules": {
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "OWNER_MUTATION_COMMITTED"
                },
                "scope": {
                  "$ref": "#/$defs/OwnerScope"
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "LOGIN_ACCOUNT_LOCKED",
                    "LOGIN_SOURCE_LOCKED",
                    "DEVICE_ENROLLED",
                    "DEVICE_REPLACED",
                    "DEVICE_REVOKED",
                    "SESSION_REVOKED",
                    "REFRESH_REUSE_DETECTED"
                  ]
                },
                "scope": {
                  "$ref": "#/$defs/AuthSecurityScope"
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "WAL_ARCHIVE_INTERRUPTED"
                },
                "scope": {
                  "$ref": "#/$defs/SystemScope"
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DEVICE_ENROLLED",
                  "DEVICE_REPLACED",
                  "DEVICE_REVOKED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "device_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "device_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "SESSION_REVOKED",
                  "REFRESH_REUSE_DETECTED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "session_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "session_id"
              ]
            }
          }
        }
      ]
    },
