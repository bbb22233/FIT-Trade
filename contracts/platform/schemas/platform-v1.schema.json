    "InboxRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "consumer",
        "event_id",
        "event_payload_digest",
        "received_at",
        "business_transaction_id",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.inbox-record.v1"
        },
        "consumer": {
          "enum": [
            "platform-consumer",
            "internal-notification-consumer"
          ]
        },
        "event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "event_payload_digest": {
          "$ref": "#/$defs/Digest"
        },
        "received_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "business_transaction_id": {
          "$ref": "#/$defs/Uuid"
        },
        "status": {
          "const": "APPLIED"
        }
      }
    },
    "OutboxRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "outbox_id",
        "event",
        "created_at",
        "publication_state",
        "retention"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.outbox-record.v1"
        },
        "outbox_id": {
          "$ref": "#/$defs/Uuid"
        },
        "event": {
          "$ref": "#/$defs/EventEnvelope"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "published_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "publication_state": {
          "enum": [
            "PENDING",
            "PUBLISHED"
          ]
        },
        "retention": {
          "const": "NEVER_DELETE_IN_PHASE_1"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publication_state": {
                "const": "PUBLISHED"
              }
            }
          },
          "then": {
            "required": [
              "published_at"
            ]
          },
          "else": {
            "not": {
              "required": [
                "published_at"
              ]
            }
          }
        }
      ]
    },
    "AuditCore": {
      "type": "object",
      "required": [
        "kind",
        "actor",
        "scope",
        "trigger",
        "causation_id",
        "correlation_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "OWNER_MUTATION_COMMITTED",
            "LOGIN_ACCOUNT_LOCKED",
            "LOGIN_SOURCE_LOCKED",
            "DEVICE_ENROLLED",
            "DEVICE_REPLACED",
            "DEVICE_REVOKED",
            "SESSION_REVOKED",
            "REFRESH_REUSE_DETECTED",
            "WAL_ARCHIVE_INTERRUPTED"
          ]
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "trigger": {
          "enum": [
            "REQUEST",
            "BACKGROUND"
          ]
        },
        "causation_id": {
          "$ref": "#/$defs/Uuid"
        },
        "correlation_id": {
          "$ref": "#/$defs/Uuid"
        },
        "request_id": {
          "$ref": "#/$defs/Uuid"
        },
        "security_operation_id": {
          "$ref": "#/$defs/Uuid"
        },
        "system_operation_id": {
          "$ref": "#/$defs/Uuid"
        },
