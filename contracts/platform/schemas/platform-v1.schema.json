{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fit.trade/contracts/platform/platform-v1.schema.json",
  "title": "FIT Trade Phase 1 platform records",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "SourceKeyDigest": {
      "type": "string",
      "pattern": "^src_[a-f0-9]{64}$"
    },
    "Ed25519Fingerprint": {
      "type": "string",
      "pattern": "^ed25519:[a-f0-9]{64}$"
    },
    "OpaqueHandle": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "OwnerScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "user_id",
        "trading_account_id"
      ],
      "properties": {
        "type": {
          "const": "OWNER"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "trading_account_id": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "AuthSecurityScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source_key"
      ],
      "properties": {
        "type": {
          "const": "AUTH_SECURITY"
        },
        "source_key": {
          "$ref": "#/$defs/SourceKeyDigest"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "SystemScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "SYSTEM"
        }
      }
    },
    "Scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/OwnerScope"
        },
        {
          "$ref": "#/$defs/AuthSecurityScope"
        },
        {
          "$ref": "#/$defs/SystemScope"
        }
      ]
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "USER",
            "DEVICE",
            "SERVICE",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "User": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "user_id",
        "status",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.user.v1"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "LOCKED",
            "DISABLED"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "TradingAccountOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ownership_id",
        "user_id",
        "trading_account_id",
        "role",
        "status",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.account-ownership.v1"
        },
        "ownership_id": {
          "$ref": "#/$defs/Uuid"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "trading_account_id": {
          "$ref": "#/$defs/Uuid"
        },
        "role": {
          "const": "OWNER"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REVOKED"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "revoked_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "REVOKED"
              }
            }
          },
          "then": {
            "required": [
              "revoked_at"
            ]
          },
          "else": {
            "not": {
              "required": [
                "revoked_at"
              ]
            }
          }
        }
      ]
    },
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "device_id",
        "user_id",
        "public_key_fingerprint",
        "key_algorithm",
        "status",
        "enrolled_at"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.device.v1"
        },
        "device_id": {
          "$ref": "#/$defs/Uuid"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "public_key_fingerprint": {
          "$ref": "#/$defs/Ed25519Fingerprint"
        },
        "key_algorithm": {
          "const": "Ed25519"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REVOKED"
          ]
        },
        "enrolled_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "revoked_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "REVOKED"
              }
            }
          },
          "then": {
            "required": [
              "revoked_at"
            ]
          },
          "else": {
            "not": {
              "required": [
                "revoked_at"
              ]
            }
          }
        }
      ]
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "session_id",
        "user_id",
        "trading_account_id",
        "device_id",
        "refresh_family_id",
        "status",
        "created_at",
        "access_expires_at"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.session.v1"
        },
        "session_id": {
          "$ref": "#/$defs/Uuid"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "trading_account_id": {
          "$ref": "#/$defs/Uuid"
        },
        "device_id": {
          "$ref": "#/$defs/Uuid"
        },
        "refresh_family_id": {
          "$ref": "#/$defs/Uuid"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "access_expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "revoked_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "REVOKED"
              }
            }
          },
          "then": {
            "required": [
              "revoked_at"
            ]
          }
        }
      ]
    },
    "RefreshTokenRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "token_digest",
        "family_id",
        "session_id",
        "issued_at",
        "expires_at",
        "family_deadline",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.refresh-record.v1"
        },
        "token_digest": {
          "$ref": "#/$defs/Digest"
        },
        "family_id": {
          "$ref": "#/$defs/Uuid"
        },
        "session_id": {
          "$ref": "#/$defs/Uuid"
        },
        "issued_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "family_deadline": {
          "$ref": "#/$defs/Timestamp"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "ROTATED",
            "REVOKED"
          ]
        },
        "rotated_to_digest": {
          "$ref": "#/$defs/Digest"
        },
        "revoked_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ROTATED"
              }
            }
          },
          "then": {
            "required": [
              "rotated_to_digest"
            ]
          },
          "else": {
            "not": {
              "required": [
                "rotated_to_digest"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REVOKED"
              }
            }
          },
          "then": {
            "required": [
              "revoked_at"
            ]
          }
        }
      ]
    },
    "EnrollmentChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "domain",
        "purpose",
        "subject_handle",
        "candidate_public_key_fingerprint",
        "nonce",
        "issued_at",
        "expires_at",
        "single_use"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.enrollment-challenge.v1"
        },
        "domain": {
          "const": "FIT_TRADE_DEVICE_ENROLLMENT_V1"
        },
        "purpose": {
          "enum": [
            "ADDITIONAL_DEVICE",
            "REPLACEMENT_DEVICE"
          ]
        },
        "subject_handle": {
          "$ref": "#/$defs/OpaqueHandle"
        },
        "candidate_public_key_fingerprint": {
          "$ref": "#/$defs/Ed25519Fingerprint"
        },
        "nonce": {
          "$ref": "#/$defs/OpaqueHandle"
        },
        "issued_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "single_use": {
          "const": true
        }
      }
    },
    "DeviceActionChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "domain",
        "user_id",
        "trading_account_id",
        "device_id",
        "session_id",
        "action",
        "payload_hash",
        "nonce",
        "issued_at",
        "expires_at",
        "single_use"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.device-action-challenge.v1"
        },
        "domain": {
          "const": "FIT_TRADE_DEVICE_ACTION_V1"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "trading_account_id": {
          "$ref": "#/$defs/Uuid"
        },
        "device_id": {
          "$ref": "#/$defs/Uuid"
        },
        "session_id": {
          "$ref": "#/$defs/Uuid"
        },
        "action": {
          "enum": [
            "OPEN_POSITION",
            "ADD_POSITION"
          ]
        },
        "payload_hash": {
          "$ref": "#/$defs/Digest"
        },
        "nonce": {
          "$ref": "#/$defs/OpaqueHandle"
        },
        "issued_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "single_use": {
          "const": true
        }
      }
    },
    "EnrollmentCompletionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_handle",
        "candidate_public_key",
        "signature"
      ],
      "properties": {
        "subject_handle": {
          "$ref": "#/$defs/OpaqueHandle"
        },
        "candidate_public_key": {
          "type": "string",
          "pattern": "^ed25519-public:[a-f0-9]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519-signature:[a-f0-9]{128}$"
        }
      }
    },
    "DeviceEnrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enrollment_id",
        "purpose",
        "user_id",
        "device_id",
        "first_session_id",
        "subject_handle_digest",
        "candidate_public_key_fingerprint",
        "proof_algorithm",
        "prior_scope_effect",
        "completed_at",
        "identity_origin"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.device-enrollment.v1"
        },
        "enrollment_id": {
          "$ref": "#/$defs/Uuid"
        },
        "purpose": {
          "enum": [
            "ADDITIONAL_DEVICE",
            "REPLACEMENT_DEVICE"
          ]
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "device_id": {
          "$ref": "#/$defs/Uuid"
        },
        "first_session_id": {
          "$ref": "#/$defs/Uuid"
        },
        "subject_handle_digest": {
          "$ref": "#/$defs/Digest"
        },
        "candidate_public_key_fingerprint": {
          "$ref": "#/$defs/Ed25519Fingerprint"
        },
        "proof_algorithm": {
          "const": "Ed25519"
        },
        "prior_scope_effect": {
          "enum": [
            "PRESERVE_EXISTING",
            "REVOKE_ALL_BEFORE_CREATE"
          ]
        },
        "completed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "identity_origin": {
          "const": "SERVER_AUTHORED"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "ADDITIONAL_DEVICE"
              }
            }
          },
          "then": {
            "properties": {
              "prior_scope_effect": {
                "const": "PRESERVE_EXISTING"
              }
            }
          },
          "else": {
            "properties": {
              "prior_scope_effect": {
                "const": "REVOKE_ALL_BEFORE_CREATE"
              }
            }
          }
        }
      ]
    },
    "DeviceActionProofInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_nonce",
        "signature"
      ],
      "properties": {
        "challenge_nonce": {
          "$ref": "#/$defs/OpaqueHandle"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519-signature:[a-f0-9]{128}$"
        }
      }
    },
    "UntrustedMutationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "path",
        "query",
        "body"
      ],
      "properties": {
        "idempotency_key": {
          "$ref": "#/$defs/Uuid"
        },
        "path": {
          "$ref": "#/$defs/UntrustedJsonObject"
        },
        "query": {
          "$ref": "#/$defs/UntrustedJsonObject"
        },
        "body": {
          "$ref": "#/$defs/UntrustedJsonObject"
        }
      }
    },
    "UntrustedJsonObject": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "user_id",
            "account_id",
            "trading_account_id",
            "session_id",
            "device_id",
            "source_key",
            "server_received_at",
            "server_time",
            "token_digest",
            "device_verification",
            "confirmation_id",
            "confirmation_hash"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/UntrustedJsonValue"
      }
    },
    "UntrustedJsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UntrustedJsonValue"
          }
        },
        {
          "$ref": "#/$defs/UntrustedJsonObject"
        }
      ]
    },
    "RequestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "method",
        "route_template",
        "path",
        "query",
        "body",
        "user_id",
        "trading_account_id",
        "session_id",
        "device_id",
        "source_key",
        "server_received_at",
        "identity_origin",
        "canonical_request_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.request-envelope.v1"
        },
        "request_id": {
          "$ref": "#/$defs/Uuid"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "route_template": {
          "type": "string",
          "pattern": "^/"
        },
        "path": {
          "type": "object"
        },
        "query": {
          "type": "object"
        },
        "body": {
          "type": "object"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "trading_account_id": {
          "$ref": "#/$defs/Uuid"
        },
        "session_id": {
          "$ref": "#/$defs/Uuid"
        },
        "device_id": {
          "$ref": "#/$defs/Uuid"
        },
        "source_key": {
          "$ref": "#/$defs/SourceKeyDigest"
        },
        "server_received_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "identity_origin": {
          "const": "SERVER_AUTHORED"
        },
        "canonical_request_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "WebSocketBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "connection_id",
        "user_id",
        "trading_account_id",
        "device_id",
        "session_id",
        "refresh_family_id",
        "access_expires_at",
        "identity_origin"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.websocket-binding.v1"
        },
        "connection_id": {
          "$ref": "#/$defs/Uuid"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "trading_account_id": {
          "$ref": "#/$defs/Uuid"
        },
        "device_id": {
          "$ref": "#/$defs/Uuid"
        },
        "session_id": {
          "$ref": "#/$defs/Uuid"
        },
        "refresh_family_id": {
          "$ref": "#/$defs/Uuid"
        },
        "access_expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "identity_origin": {
          "const": "SERVER_AUTHORED"
        }
      }
    },
    "WebSocketReauthRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "nonce",
        "issued_at",
        "deadline",
        "current_access_expires_at"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.websocket-control.v1"
        },
        "type": {
          "const": "REAUTH_REQUIRED"
        },
        "nonce": {
          "$ref": "#/$defs/OpaqueHandle"
        },
        "issued_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "deadline": {
          "$ref": "#/$defs/Timestamp"
        },
        "current_access_expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "WebSocketReauth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "nonce",
        "access_token_transport"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.websocket-control.v1"
        },
        "type": {
          "const": "REAUTH"
        },
        "nonce": {
          "$ref": "#/$defs/OpaqueHandle"
        },
        "access_token_transport": {
          "type": "string",
          "minLength": 24,
          "maxLength": 4096,
          "writeOnly": true
        }
      }
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "subject",
        "stream",
        "event_id",
        "event_kind",
        "scope",
        "aggregate_type",
        "aggregate_id",
        "aggregate_version",
        "causation_id",
        "correlation_id",
        "occurred_at",
        "payload_schema_version",
        "payload_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "fit.platform.event-envelope.v1"
        },
        "subject": {
          "enum": [
            "fit.platform.v1.owner.owner-mutation-committed",
            "fit.platform.v1.auth-security.login-account-locked",
            "fit.platform.v1.auth-security.login-source-locked",
            "fit.platform.v1.auth-security.device-enrolled",
            "fit.platform.v1.auth-security.device-replaced",
            "fit.platform.v1.auth-security.device-revoked",
            "fit.platform.v1.auth-security.session-revoked",
            "fit.platform.v1.auth-security.refresh-reuse-detected",
            "fit.platform.v1.system.wal-archive-interrupted",
            "fit.platform.v1.notification.login-account-locked",
            "fit.platform.v1.notification.login-source-locked",
            "fit.platform.v1.notification.device-enrolled",
            "fit.platform.v1.notification.device-replaced",
            "fit.platform.v1.notification.device-revoked",
            "fit.platform.v1.notification.session-revoked",
            "fit.platform.v1.notification.refresh-reuse-detected",
            "fit.platform.v1.notification.wal-archive-interrupted"
          ]
        },
        "stream": {
          "const": "FIT_PLATFORM_V1"
        },
        "event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "event_kind": {
          "enum": [
            "OWNER_MUTATION_COMMITTED",
            "LOGIN_ACCOUNT_LOCKED",
            "LOGIN_SOURCE_LOCKED",
            "DEVICE_ENROLLED",
            "DEVICE_REPLACED",
            "DEVICE_REVOKED",
            "SESSION_REVOKED",
            "REFRESH_REUSE_DETECTED",
            "WAL_ARCHIVE_INTERRUPTED"
          ]
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "aggregate_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "aggregate_id": {
          "$ref": "#/$defs/Uuid"
        },
        "aggregate_version": {
