{
  "schema_version": "fit.platform.transaction-boundaries.v1",
  "authority": {
    "system_of_record": "POSTGRESQL",
    "nats": "DERIVED_DELIVERY_ONLY",
    "control_plane_scope_grants_owner_authority": false
  },
  "server_owned_fields": [
    "user_id",
    "trading_account_id",
    "session_id",
    "device_id",
    "source_key",
    "source_key_digest",
    "server_received_at",
    "server_time",
    "token_digest",
    "family_id",
    "family_created_at",
    "family_deadline",
    "refresh_family_id",
    "rotated_to_digest",
    "canonical_request_digest",
    "device_verification",
    "identity_origin",
    "signature_verified"
  ],
  "model_tool_forbidden_authority_fields": [
    "confirmation_id",
    "confirmation_hash"
  ],
  "workflows": [
    {
      "name": "successful_login",
      "single_postgresql_transaction": [
        "lock_source_throttle_dimension",
        "resolve_user_without_disclosure",
        "lock_resolved_user_throttle_dimension",
        "prune_failures_outside_rolling_window",
        "verify_neither_dimension_delayed_or_locked",
        "verify_password",
        "clear_resolved_user_failures_only",
        "preserve_source_failures",
        "invalidate_preauthentication_identifier",
        "create_server_random_session",
        "create_server_random_refresh_family_with_fixed_deadline",
        "persist_initial_refresh_digest",
        "write_immutable_audit_and_outbox"
      ],
      "audit_event_kind": "LOGIN_SUCCEEDED",
      "outbox_subject": "fit.platform.v1.auth-security.login-succeeded",
      "new_session_and_family_required": true,
      "stable_request_key": "idempotency_key",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_RESULT_FROM_AEAD_RESPONSE_CACHE",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "response_cache": "AEAD_CIPHERTEXT_ONLY_RUNTIME_KEY_NOT_DATABASE_TTL_120_SECONDS",
      "response_cache_expired_same_key": "RECONCILIATION_REQUIRED_NO_REEXECUTION",
      "commit_before_credential_response": true
    },
    {
      "name": "real_enrollment_challenge_creation",
      "single_postgresql_transaction": [
        "lock_source_throttle_dimension",
        "resolve_user_without_disclosure",
        "lock_resolved_user_throttle_dimension",
        "prune_failures_outside_rolling_window",
        "verify_neither_dimension_delayed_or_locked",
        "verify_password",
        "clear_resolved_user_failures_only",
        "preserve_source_failures",
        "assert_resolved_user",
        "create_random_opaque_subject_handle",
        "persist_single_use_challenge_and_candidate_fingerprint",
        "write_challenge_audit_and_outbox"
      ],
      "audit_event_kind": "ENROLLMENT_CHALLENGE_ISSUED",
      "outbox_subject": "fit.platform.v1.auth-security.enrollment-challenge-issued",
      "stable_request_key": "idempotency_key",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_CHALLENGE",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "commit_before_challenge_response": true
    },
    {
      "name": "synthetic_enrollment_challenge_response",
      "must_not_persist": true,
      "must_not_create": [
        "challenge",
        "device",
        "session",
        "refresh_family",
        "audit_owner_scope"
      ],
      "response_steps": [
        "create_process_local_random_opaque_handle",
        "return_contract_valid_synthetic_challenge"
      ]
    },
    {
      "name": "failed_enrollment_proof",
      "single_postgresql_transaction": [
        "lock_and_consume_real_challenge_once",
        "persist_invalid_proof_audit",
        "write_invalid_proof_outbox",
        "assert_no_device_session_or_family_created"
      ],
      "audit_event_kind": "ENROLLMENT_PROOF_REJECTED",
      "outbox_subject": "fit.platform.v1.auth-security.enrollment-proof-rejected",
      "stable_request_key": "idempotency_key",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_REJECTION",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "commit_before_rejection_response": true
    },
    {
      "name": "device_revocation",
      "single_postgresql_transaction": [
        "lock_active_device",
        "revoke_device_and_bound_sessions_and_families",
        "persist_device_revocation_audit",
        "persist_device_revocation_notification",
        "write_device_revocation_outbox_events"
      ],
      "stable_request_key": "idempotency_key",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_RESULT",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "commit_before_response": true
    },
    {
      "name": "session_revocation",
      "single_postgresql_transaction": [
        "lock_active_session",
        "revoke_session_and_refresh_family",
        "persist_session_revocation_audit",
        "persist_session_revocation_notification",
        "write_session_revocation_outbox_events"
      ],
      "stable_request_key": "idempotency_key",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_RESULT",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "commit_before_response": true
    },
    {
      "name": "owner_mutation",
      "single_postgresql_transaction": [
        "verify_owner_scope",
        "claim_idempotency_key_and_request_digest",
        "write_business_effect",
        "write_immutable_audit_event",
        "write_outbox_event"
      ],
      "stable_request_key": "idempotency_key",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_RESULT",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "commit_before_response": true
    },
    {
      "name": "nats_consumer_business_effect",
      "single_postgresql_transaction": [
        "lock_or_insert_inbox_deduplication_record",
        "verify_event_owner_scope",
        "write_business_effect",
        "write_immutable_audit_event",
        "write_outbox_event",
        "mark_inbox_applied"
      ],
      "ack_after_commit": true
    },
    {
      "name": "password_failure",
      "single_postgresql_transaction": [
        "lock_source_throttle_dimension",
        "resolve_user_without_disclosure",
        "lock_resolved_user_throttle_dimension_if_present",
        "prune_failures_outside_rolling_window",
        "record_source_failure",
        "record_resolved_user_failure_if_present",
        "set_next_allowed_or_lock_each_dimension",
        "persist_lock_audit_notification_and_outbox_only_if_threshold_reached"
      ],
      "rolling_window_seconds": 900,
      "stable_request_key": "request_id",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_REJECTION_WITHOUT_INCREMENT",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "commit_before_rejection_response": true
    },
    {
      "name": "ordinary_device_enrollment",
      "single_postgresql_transaction": [
        "consume_real_challenge_once",
        "verify_candidate_ed25519_proof",
        "assert_global_public_key_uniqueness",
        "create_server_owned_device",
        "create_independent_session_and_refresh_family",
        "write_immutable_audit_event",
        "write_internal_notification",
        "write_outbox_events"
      ],
      "must_not_write": [
        "prior_device_revocation",
        "prior_session_revocation",
        "prior_refresh_family_revocation"
      ],
      "stable_request_key": "idempotency_key",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_RESULT_FROM_AEAD_RESPONSE_CACHE",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "response_cache": "AEAD_CIPHERTEXT_ONLY_RUNTIME_KEY_NOT_DATABASE_TTL_120_SECONDS",
      "response_cache_expired_same_key": "RECONCILIATION_REQUIRED_NO_REEXECUTION",
      "commit_before_response": true
    },
    {
      "name": "replacement_device_enrollment",
      "single_postgresql_transaction": [
        "consume_real_challenge_once",
        "verify_candidate_ed25519_proof",
        "revoke_all_prior_devices",
        "revoke_all_prior_sessions",
        "revoke_all_prior_refresh_families",
        "assert_global_public_key_uniqueness",
        "create_server_owned_device",
        "create_independent_session_and_refresh_family",
        "write_immutable_audit_event",
        "write_internal_notification",
        "write_outbox_events"
      ],
      "revocation_before_new_session": true,
      "stable_request_key": "idempotency_key",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_RESULT_FROM_AEAD_RESPONSE_CACHE",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "response_cache": "AEAD_CIPHERTEXT_ONLY_RUNTIME_KEY_NOT_DATABASE_TTL_120_SECONDS",
      "response_cache_expired_same_key": "RECONCILIATION_REQUIRED_NO_REEXECUTION",
      "commit_before_response": true
    },
    {
      "name": "refresh_rotation",
      "single_postgresql_transaction": [
        "lock_refresh_family",
        "evaluate_family_deadline",
        "evaluate_already_rotated_reuse",
        "evaluate_individual_expiry",
        "rotate_active_digest_or_revoke_complete_family",
        "write_security_audit_if_reuse",
        "write_internal_notification_if_reuse",
        "write_outbox_events_if_reuse"
      ],
      "stable_request_key": "idempotency_key",
      "same_key_same_digest_after_response_loss": "RETURN_RECORDED_ROTATION_FROM_AEAD_RESPONSE_CACHE_WITHOUT_REUSE_CLASSIFICATION",
      "same_key_different_digest": "IDEMPOTENCY_CONFLICT",
      "different_key_for_rotated_digest": "REVOKE_FAMILY_AND_DESCENDANTS",
      "response_cache": "AEAD_CIPHERTEXT_ONLY_RUNTIME_KEY_NOT_DATABASE_TTL_120_SECONDS",
      "response_cache_expired_same_key": "RECONCILIATION_REQUIRED_NO_REEXECUTION",
      "commit_before_credential_response": true
    },
    {
      "name": "outbox_publish",
      "claim_postgresql_transaction": [
        "claim_unpublished_outbox_record_with_expiring_lease"
      ],
      "broker_phase": [
        "publish_exact_event_id_and_payload_digest",
        "receive_broker_ack"
      ],
      "mark_postgresql_transaction": [
        "mark_outbox_published"
      ],
      "duplicate_publish_allowed": true,
      "duplicate_business_effect_allowed": false,
      "delete_business_event_allowed_in_phase_1": false
    },
    {
      "name": "wal_archive_incident",
      "single_postgresql_transaction": [
        "upsert_one_open_incident",
        "write_one_immutable_audit_event_per_incident",
        "write_one_internal_notification_per_incident",
        "write_outbox_events"
      ],
      "clear_condition": "two_consecutive_successes_and_age_at_or_below_60_seconds"
    }
  ],
  "idempotency": {
    "scope": [
      "user_id",
      "trading_account_id",
      "route_template",
      "idempotency_key"
    ],
    "same_scope_same_key_same_digest": "RETURN_RECORDED_RESULT",
    "same_scope_same_key_different_digest": "IDEMPOTENCY_CONFLICT",
    "claim_and_business_effect_same_transaction": true
  },
  "referential_invariants": [
    "ownership.user_id references user.user_id",
    "device.user_id references user.user_id",
    "session.user_id equals device.user_id",
    "session.trading_account_id has active ownership for session.user_id",
    "refresh_token.session_id references session.session_id",
    "refresh_token.family_id equals refresh_family.family_id",
    "refresh_token.session_id equals refresh_family.session_id",
    "refresh_token.rotated_to_digest references an acyclic descendant issued before the parent expires in the same family and session",
    "inbox.event_id is unique per consumer",
    "outbox.event.event_id is globally unique",
    "aggregate_version is unique and contiguous per aggregate",
    "aggregate event version greater than the starting version links the exact previous event ID",
    "audit and notification payload_digest equals SHA-256 over RFC8785 JCS of the complete record with payload_digest omitted",
    "device public key fingerprint is globally unique",
    "audit and notification scope never fabricates owner identity"
  ],
  "outbox_retention": "NEVER_DELETE_BUSINESS_EVENTS_IN_PHASE_1"
}
