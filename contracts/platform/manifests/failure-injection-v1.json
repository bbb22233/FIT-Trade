{
  "schema_version": "fit.platform.failure-injection.v1",
  "coverage_model": "DERIVE_EVERY_CUT_FROM_TRANSACTION_BOUNDARIES_MANIFEST",
  "injection_methods": [
    "PROCESS_KILL",
    "TRANSACTION_ABORT",
    "NETWORK_PARTITION",
    "BROKER_ACK_LOSS"
  ],
  "workflow_requirements": [
    {
      "workflow": "successful_login",
      "transaction_groups": [["single_postgresql_transaction"]]
    },
    {
      "workflow": "real_enrollment_challenge_creation",
      "transaction_groups": [["single_postgresql_transaction"]]
    },
    {
      "workflow": "synthetic_enrollment_challenge_response",
      "transaction_groups": [],
      "must_not_persist": true
    },
    {
      "workflow": "failed_enrollment_proof",
      "transaction_groups": [["single_postgresql_transaction"]]
    },
    {
      "workflow": "device_revocation",
      "transaction_groups": [["single_postgresql_transaction"]]
    },
    {
      "workflow": "session_revocation",
      "transaction_groups": [["single_postgresql_transaction"]]
    },
    {
      "workflow": "owner_mutation",
      "transaction_groups": [[
        "single_postgresql_transaction",
        "conditional_same_transaction"
      ]]
    },
    {
      "workflow": "nats_consumer_business_effect",
      "transaction_groups": [["single_postgresql_transaction"]],
      "external_boundaries": [
        "AFTER_POSTGRESQL_COMMIT_BEFORE_NATS_ACK",
        "AFTER_NATS_ACK"
      ]
    },
    {
      "workflow": "password_failure",
      "transaction_groups": [
        [
          "single_postgresql_transaction"
        ]
      ]
    },
    {
      "workflow": "password_lock",
      "transaction_groups": [["single_postgresql_transaction"]]
    },
    {
      "workflow": "ordinary_device_enrollment",
      "transaction_groups": [["single_postgresql_transaction"]]
    },
    {
      "workflow": "replacement_device_enrollment",
      "transaction_groups": [["single_postgresql_transaction"]]
    },
    {
      "workflow": "refresh_rotation",
      "transaction_groups": [["single_postgresql_transaction"]]
    },
    {
      "workflow": "outbox_publish",
      "transaction_groups": [
        ["claim_postgresql_transaction"],
        ["mark_postgresql_transaction"]
      ],
      "external_boundaries": [
        "AFTER_CLAIM_COMMIT_BEFORE_PUBLISH",
        "AFTER_PUBLISH_BEFORE_BROKER_ACK",
        "AFTER_BROKER_ACK_BEFORE_MARK_TRANSACTION",
        "AFTER_MARK_COMMIT"
      ]
    },
    {
      "workflow": "wal_archive_incident",
      "transaction_groups": [["single_postgresql_transaction"]]
    }
  ],
  "transaction_cut_rule": {
    "before_first_statement": "NO_DURABLE_EFFECT",
    "after_every_statement_before_next_or_commit": "INJECT_TRANSACTION_ABORT_AND_REQUIRE_COMPLETE_ROLLBACK",
    "after_commit": "RETRY_MUST_OBSERVE_COMPLETE_DURABLE_TRANSACTION_WITH_NO_PARTIAL_EFFECT",
    "statement_order_source": "transaction-boundaries-v1.json",
    "conditional_statement_policy": "EXERCISE_BOTH_ABSENT_AND_PRESENT_PATHS"
  },
  "external_cut_rule": {
    "publish_retry_identity": [
      "event_id",
      "payload_digest"
    ],
    "ack_loss": "REDELIVERY_MUST_HIT_INBOX_AND_CREATE_NO_DUPLICATE_BUSINESS_EFFECT",
    "event_retention": "NEVER_DELETE_IN_PHASE_1"
  },
  "coverage_requirements": {
    "every_transaction_manifest_workflow": true,
    "every_postgresql_transaction_segment": true,
    "every_postgresql_statement_boundary": true,
    "every_commit_boundary": true,
    "every_publish_boundary": true,
    "every_ack_boundary": true,
    "zero_persistence_workflows_prove_no_write": true
  }
}
