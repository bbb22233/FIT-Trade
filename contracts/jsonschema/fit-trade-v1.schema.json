{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fit-trade.local/contracts/fit-trade-v1.schema.json",
  "title": "FIT-Trade v1 domain contracts",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/TradeIntent" },
    { "$ref": "#/$defs/ConfirmationTicket" },
    { "$ref": "#/$defs/Operation" },
    { "$ref": "#/$defs/ExecutionAttempt" },
    { "$ref": "#/$defs/Order" },
    { "$ref": "#/$defs/Fill" },
    { "$ref": "#/$defs/PositionSnapshot" },
    { "$ref": "#/$defs/RiskPolicy" },
    { "$ref": "#/$defs/AutomationGrant" },
    { "$ref": "#/$defs/ModelProposal" },
    { "$ref": "#/$defs/ModelReview" },
    { "$ref": "#/$defs/RiskDecision" },
    { "$ref": "#/$defs/ExecutionCommand" },
    { "$ref": "#/$defs/ExecutionResult" },
    { "$ref": "#/$defs/ProtectionStatus" },
    { "$ref": "#/$defs/ReconciliationStatus" },
    { "$ref": "#/$defs/AgentFeedback" },
    { "$ref": "#/$defs/AutomationAuthorization" },
    { "$ref": "#/$defs/AuditEvent" }
  ],
  "$defs": {
    "SchemaVersion": {
      "const": "fit.trade.v1"
    },
    "UUID": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{0,17}[1-9])?$",
      "maxLength": 38
    },
    "NonNegativeDecimal": {
      "allOf": [
        { "$ref": "#/$defs/Decimal" },
        {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{0,17}[1-9])?$"
        }
      ]
    },
    "PositiveDecimal": {
      "allOf": [
        { "$ref": "#/$defs/NonNegativeDecimal" },
        { "not": { "type": "string", "pattern": "^0$" } }
      ]
    },
    "Fraction": {
      "allOf": [
        { "$ref": "#/$defs/NonNegativeDecimal" },
        {
          "type": "string",
          "pattern": "^(?:0(?:\\.[0-9]{0,17}[1-9])?|1)$"
        }
      ]
    },
    "PositiveFraction": {
      "allOf": [
        { "$ref": "#/$defs/Fraction" },
        { "not": { "type": "string", "pattern": "^0$" } }
      ]
    },
    "Network": {
      "enum": ["HYPERLIQUID_MAINNET", "HYPERLIQUID_TESTNET"]
    },
    "Symbol": {
      "enum": ["BTC-PERP", "ETH-PERP", "SOL-PERP"]
    },
    "Side": {
      "enum": ["BUY", "SELL"]
    },
    "PositionEffect": {
      "enum": ["OPEN", "INCREASE", "REDUCE", "CLOSE"]
    },
    "OrderType": {
      "enum": ["MARKET", "LIMIT"]
    },
    "TimeInForce": {
      "enum": ["IOC", "GTC", "ALO"]
    },
    "MarginMode": {
      "enum": ["CROSS", "ISOLATED"]
    },
    "DataStatus": {
      "enum": ["LIVE", "STALE", "RECONCILING"]
    },
    "StopMarket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "trigger_price", "reduce_only"],
      "properties": {
        "type": { "const": "STOP_MARKET" },
        "trigger_price": { "$ref": "#/$defs/PositiveDecimal" },
        "reduce_only": { "const": true }
      }
    },
    "TakeProfitLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger_price", "quantity_fraction", "reduce_only"],
      "properties": {
        "trigger_price": { "$ref": "#/$defs/PositiveDecimal" },
        "quantity_fraction": {
          "$ref": "#/$defs/PositiveFraction"
        },
        "reduce_only": { "const": true }
      }
    },
    "SymbolLeverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "maximum_leverage"],
      "properties": {
        "symbol": { "$ref": "#/$defs/Symbol" },
        "maximum_leverage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "TradeIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "intent_id",
        "user_id",
        "account_id",
        "network",
        "symbol",
        "side",
        "position_effect",
        "order_type",
        "time_in_force",
        "quantity",
        "notional",
        "margin_mode",
        "leverage",
        "entry_price_or_bound",
        "worst_acceptable_price",
        "take_profit_plan",
        "risk_policy_version",
        "market_snapshot_id",
        "strategy_version",
        "model_version",
        "source",
        "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "intent_id": { "$ref": "#/$defs/UUID" },
        "user_id": { "$ref": "#/$defs/UUID" },
        "account_id": { "$ref": "#/$defs/UUID" },
        "network": { "$ref": "#/$defs/Network" },
        "symbol": { "$ref": "#/$defs/Symbol" },
        "side": { "$ref": "#/$defs/Side" },
        "position_effect": { "$ref": "#/$defs/PositionEffect" },
        "order_type": { "$ref": "#/$defs/OrderType" },
        "time_in_force": { "$ref": "#/$defs/TimeInForce" },
        "quantity": { "$ref": "#/$defs/PositiveDecimal" },
        "notional": { "$ref": "#/$defs/PositiveDecimal" },
        "margin_mode": { "$ref": "#/$defs/MarginMode" },
        "leverage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "entry_price_or_bound": { "$ref": "#/$defs/PositiveDecimal" },
        "worst_acceptable_price": { "$ref": "#/$defs/PositiveDecimal" },
        "stop": { "$ref": "#/$defs/StopMarket" },
        "take_profit_plan": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/TakeProfitLeg" }
        },
        "risk_policy_version": {
          "type": "string",
          "pattern": "^risk-[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "market_snapshot_id": { "$ref": "#/$defs/UUID" },
        "strategy_version": {
          "type": "string",
          "pattern": "^strategy-[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "model_version": {
          "type": "string",
          "pattern": "^model-[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "source": { "enum": ["USER_DIRECTED", "AUTOMATION"] },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "position_effect": { "enum": ["OPEN", "INCREASE"] }
            },
            "required": ["position_effect"]
          },
          "then": {
            "properties": { "stop": true },
            "required": ["stop"]
          }
        },
        {
          "if": {
            "properties": { "order_type": { "const": "MARKET" } },
            "required": ["order_type"]
          },
          "then": {
            "properties": { "time_in_force": { "const": "IOC" } }
          }
        },
        {
          "if": {
            "properties": { "order_type": { "const": "LIMIT" } },
            "required": ["order_type"]
          },
          "then": {
            "properties": {
              "time_in_force": { "enum": ["GTC", "ALO"] }
            }
          }
        }
      ]
    },
    "ConfirmationTicket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "confirmation_id",
        "device_id",
        "session_id",
        "intent",
        "maximum_loss",
        "maximum_loss_fraction",
        "post_trade_total_risk",
        "post_trade_total_risk_fraction",
        "liquidation_price",
        "estimated_fees",
        "slippage_budget",
        "expires_at",
        "confirmation_nonce",
        "confirmation_hash",
        "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "confirmation_id": { "$ref": "#/$defs/UUID" },
        "device_id": { "$ref": "#/$defs/UUID" },
        "session_id": { "$ref": "#/$defs/UUID" },
        "intent": { "$ref": "#/$defs/TradeIntent" },
        "maximum_loss": { "$ref": "#/$defs/NonNegativeDecimal" },
        "maximum_loss_fraction": { "$ref": "#/$defs/Fraction" },
        "post_trade_total_risk": { "$ref": "#/$defs/NonNegativeDecimal" },
        "post_trade_total_risk_fraction": {
          "$ref": "#/$defs/Fraction"
        },
        "liquidation_price": { "$ref": "#/$defs/PositiveDecimal" },
        "estimated_fees": { "$ref": "#/$defs/NonNegativeDecimal" },
        "slippage_budget": { "$ref": "#/$defs/NonNegativeDecimal" },
        "expires_at": { "$ref": "#/$defs/Timestamp" },
        "confirmation_nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32,128}$"
        },
        "confirmation_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "properties": {
            "intent": {
              "allOf": [
                { "$ref": "#/$defs/TradeIntent" },
                {
                  "type": "object",
                  "properties": {
                    "position_effect": { "enum": ["OPEN", "INCREASE"] }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "intent_id",
        "state",
        "state_version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "operation_id": { "$ref": "#/$defs/UUID" },
        "intent_id": { "$ref": "#/$defs/UUID" },
        "confirmation_id": { "$ref": "#/$defs/UUID" },
        "state": {
          "enum": [
            "DRAFT",
            "AWAITING_CONFIRMATION",
            "EXPIRED",
            "CONFIRMED",
            "RISK_REVALIDATING",
            "REJECTED",
            "ADMITTED",
            "DISPATCH_PENDING",
            "DISPATCHED",
            "ACKNOWLEDGED",
            "UNKNOWN_REQUIRES_RECONCILIATION",
            "MANUAL_RECONCILIATION",
            "FINAL"
          ]
        },
        "state_version": { "type": "integer", "minimum": 0 },
        "rejection_code": { "type": "string", "maxLength": 96 },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ExecutionAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "operation_id",
        "client_order_id",
        "attempt_number",
        "state",
        "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "attempt_id": { "$ref": "#/$defs/UUID" },
        "operation_id": { "$ref": "#/$defs/UUID" },
        "client_order_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "attempt_number": { "type": "integer", "minimum": 1, "maximum": 32 },
        "state": {
          "enum": [
            "CREATED",
            "SIGNED",
            "SUBMITTED",
            "ACKNOWLEDGED",
            "UNKNOWN_REQUIRES_RECONCILIATION",
            "REJECTED"
          ]
        },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "order_id",
        "operation_id",
        "client_order_id",
        "symbol",
        "side",
        "quantity",
        "filled_quantity",
        "reduce_only",
        "state",
        "updated_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "order_id": { "$ref": "#/$defs/UUID" },
        "operation_id": { "$ref": "#/$defs/UUID" },
        "client_order_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "exchange_order_id": { "type": "string", "maxLength": 128 },
        "symbol": { "$ref": "#/$defs/Symbol" },
        "side": { "$ref": "#/$defs/Side" },
        "quantity": { "$ref": "#/$defs/PositiveDecimal" },
        "filled_quantity": { "$ref": "#/$defs/NonNegativeDecimal" },
        "limit_price": { "$ref": "#/$defs/PositiveDecimal" },
        "reduce_only": { "type": "boolean" },
        "state": {
          "enum": [
            "PENDING",
            "OPEN",
            "PARTIALLY_FILLED",
            "FILLED",
            "CANCELLED",
            "REJECTED",
            "UNKNOWN_REQUIRES_RECONCILIATION"
          ]
        },
        "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Fill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fill_id",
        "order_id",
        "symbol",
        "side",
        "quantity",
        "price",
        "fee",
        "occurred_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "fill_id": { "$ref": "#/$defs/UUID" },
        "order_id": { "$ref": "#/$defs/UUID" },
        "symbol": { "$ref": "#/$defs/Symbol" },
        "side": { "$ref": "#/$defs/Side" },
        "quantity": { "$ref": "#/$defs/PositiveDecimal" },
        "price": { "$ref": "#/$defs/PositiveDecimal" },
        "fee": { "$ref": "#/$defs/NonNegativeDecimal" },
        "occurred_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "PositionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "position_id",
        "account_id",
        "symbol",
        "signed_quantity",
        "entry_price",
        "mark_price",
        "protection_status_id",
        "protection_state",
        "data_status",
        "snapshot_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "position_id": { "$ref": "#/$defs/UUID" },
        "account_id": { "$ref": "#/$defs/UUID" },
        "symbol": { "$ref": "#/$defs/Symbol" },
        "signed_quantity": { "$ref": "#/$defs/Decimal" },
        "entry_price": { "$ref": "#/$defs/PositiveDecimal" },
        "mark_price": { "$ref": "#/$defs/PositiveDecimal" },
        "protection_status_id": { "$ref": "#/$defs/UUID" },
        "protection_state": {
          "enum": [
            "NO_POSITION",
            "ENTRY_PENDING",
            "PARTIALLY_FILLED",
            "FILLED",
            "PROTECTION_PENDING",
            "PROTECTED",
            "ADJUSTING_PROTECTION",
            "PROTECTION_FAILED",
            "EMERGENCY_CLOSING",
            "MANUAL_RECONCILIATION",
            "CLOSED"
          ]
        },
        "data_status": { "$ref": "#/$defs/DataStatus" },
        "snapshot_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "RiskPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "risk_policy_version",
        "allowed_symbols",
        "maximum_trade_risk_fraction",
        "maximum_total_risk_fraction",
        "maximum_leverage_by_symbol",
        "maximum_slippage_fraction",
        "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "risk_policy_version": {
          "type": "string",
          "pattern": "^risk-[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "allowed_symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Symbol" }
        },
        "maximum_trade_risk_fraction": {
          "$ref": "#/$defs/PositiveFraction"
        },
        "maximum_total_risk_fraction": {
          "$ref": "#/$defs/PositiveFraction"
        },
        "maximum_leverage_by_symbol": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SymbolLeverage" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "symbol": { "const": "BTC-PERP" } },
                "required": ["symbol"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "symbol": { "const": "ETH-PERP" } },
                "required": ["symbol"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "symbol": { "const": "SOL-PERP" } },
                "required": ["symbol"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "maximum_slippage_fraction": {
          "$ref": "#/$defs/PositiveFraction"
        },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AutomationGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "grant_id",
        "user_id",
        "account_id",
        "state",
        "allowed_symbols",
        "risk_policy_version",
        "strategy_version",
        "model_version",
        "review_model_version",
        "maximum_notional",
        "authorization_hash"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "grant_id": { "$ref": "#/$defs/UUID" },
        "user_id": { "$ref": "#/$defs/UUID" },
        "account_id": { "$ref": "#/$defs/UUID" },
        "state": { "enum": ["DISABLED", "ENABLED", "SAFETY_PAUSED"] },
        "allowed_symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Symbol" }
        },
        "risk_policy_version": { "type": "string", "maxLength": 64 },
        "strategy_version": { "type": "string", "maxLength": 64 },
        "model_version": { "type": "string", "maxLength": 64 },
        "review_model_version": { "type": "string", "maxLength": 64 },
        "maximum_notional": { "$ref": "#/$defs/PositiveDecimal" },
        "authorization_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "ModelProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "proposal_id",
        "model_version",
        "decision",
        "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "proposal_id": { "$ref": "#/$defs/UUID" },
        "model_version": { "type": "string", "maxLength": 64 },
        "decision": { "enum": ["PROPOSE_TRADE", "NO_TRADE"] },
        "intent": { "$ref": "#/$defs/TradeIntent" },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "PROPOSE_TRADE" } },
            "required": ["decision"]
          },
          "then": {
            "properties": { "intent": true },
            "required": ["intent"]
          }
        },
        {
          "if": {
            "properties": { "decision": { "const": "NO_TRADE" } },
            "required": ["decision"]
          },
          "then": {
            "not": {
              "properties": { "intent": true },
              "required": ["intent"]
            }
          }
        }
      ]
    },
    "ModelReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "review_id",
        "proposal_id",
        "review_model_version",
        "decision",
        "reason_codes",
        "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "review_id": { "$ref": "#/$defs/UUID" },
        "proposal_id": { "$ref": "#/$defs/UUID" },
        "review_model_version": { "type": "string", "maxLength": 64 },
        "decision": { "enum": ["APPROVE", "REJECT", "NO_TRADE"] },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "RiskDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision_id",
        "intent_id",
        "risk_policy_version",
        "result",
        "reason_codes",
        "admitted_quantity",
        "maximum_loss",
        "maximum_loss_fraction",
        "post_trade_total_risk",
        "post_trade_total_risk_fraction",
        "market_snapshot_id",
        "decided_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "decision_id": { "$ref": "#/$defs/UUID" },
        "intent_id": { "$ref": "#/$defs/UUID" },
        "risk_policy_version": { "type": "string", "maxLength": 64 },
        "result": { "enum": ["ADMITTED", "REJECTED"] },
        "reason_codes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "admitted_quantity": { "$ref": "#/$defs/NonNegativeDecimal" },
        "maximum_loss": { "$ref": "#/$defs/NonNegativeDecimal" },
        "maximum_loss_fraction": { "$ref": "#/$defs/Fraction" },
        "post_trade_total_risk": { "$ref": "#/$defs/NonNegativeDecimal" },
        "post_trade_total_risk_fraction": { "$ref": "#/$defs/Fraction" },
        "market_snapshot_id": { "$ref": "#/$defs/UUID" },
        "decided_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ExecutionCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "operation_id",
        "attempt_id",
        "authorization_type",
        "authorization_id",
        "action",
        "reduce_only",
        "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/UUID" },
        "operation_id": { "$ref": "#/$defs/UUID" },
        "attempt_id": { "$ref": "#/$defs/UUID" },
        "authorization_type": {
          "enum": ["USER_CONFIRMATION", "AUTOMATION_GRANT", "RISK_REDUCTION"]
        },
        "authorization_id": { "$ref": "#/$defs/UUID" },
        "action": {
          "enum": ["PLACE_ORDER", "CANCEL_ENTRY", "REPLACE_STOP", "RECONCILE"]
        },
        "client_order_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "symbol": { "$ref": "#/$defs/Symbol" },
        "side": { "$ref": "#/$defs/Side" },
        "order_type": { "$ref": "#/$defs/OrderType" },
        "time_in_force": { "$ref": "#/$defs/TimeInForce" },
        "quantity": { "$ref": "#/$defs/PositiveDecimal" },
        "worst_acceptable_price": { "$ref": "#/$defs/PositiveDecimal" },
        "reduce_only": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "PLACE_ORDER" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "client_order_id": true,
              "symbol": true,
              "side": true,
              "order_type": true,
              "time_in_force": true,
              "quantity": true,
              "worst_acceptable_price": true
            },
            "required": [
              "client_order_id",
              "symbol",
              "side",
              "order_type",
              "time_in_force",
              "quantity",
              "worst_acceptable_price"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "authorization_type": { "const": "RISK_REDUCTION" }
            },
            "required": ["authorization_type"]
          },
          "then": {
            "properties": { "reduce_only": { "const": true } }
          }
        },
        {
          "if": {
            "properties": {
              "action": { "const": "PLACE_ORDER" },
              "order_type": { "const": "MARKET" }
            },
            "required": ["action", "order_type"]
          },
          "then": {
            "properties": { "time_in_force": { "const": "IOC" } }
          }
        },
        {
          "if": {
            "properties": {
              "action": { "const": "PLACE_ORDER" },
              "order_type": { "const": "LIMIT" }
            },
            "required": ["action", "order_type"]
          },
          "then": {
            "properties": {
              "time_in_force": { "enum": ["GTC", "ALO"] }
            }
          }
        }
      ]
    },
    "ExecutionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result_id",
        "command_id",
        "attempt_id",
        "status",
        "observed_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "result_id": { "$ref": "#/$defs/UUID" },
        "command_id": { "$ref": "#/$defs/UUID" },
        "attempt_id": { "$ref": "#/$defs/UUID" },
        "status": {
          "enum": [
            "ACKNOWLEDGED",
            "REJECTED",
            "NOT_DISPATCHED",
            "UNKNOWN_REQUIRES_RECONCILIATION"
          ]
        },
        "exchange_order_id": { "type": "string", "maxLength": 128 },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
        },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ProtectionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protection_status_id",
        "position_id",
        "state",
        "absolute_live_position_quantity",
        "active_stop_order_ids",
        "data_status",
        "observed_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "protection_status_id": { "$ref": "#/$defs/UUID" },
        "position_id": { "$ref": "#/$defs/UUID" },
        "state": {
          "enum": [
            "NO_POSITION",
            "ENTRY_PENDING",
            "PARTIALLY_FILLED",
            "FILLED",
            "PROTECTION_PENDING",
            "PROTECTED",
            "ADJUSTING_PROTECTION",
            "PROTECTION_FAILED",
            "EMERGENCY_CLOSING",
            "MANUAL_RECONCILIATION",
            "CLOSED"
          ]
        },
        "absolute_live_position_quantity": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "active_stop_order_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 128 }
        },
        "coverage_evidence_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "data_status": { "$ref": "#/$defs/DataStatus" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "PROTECTED" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "absolute_live_position_quantity": {
                "$ref": "#/$defs/PositiveDecimal"
              },
              "active_stop_order_ids": {
                "type": "array",
                "minItems": 1
              },
              "coverage_evidence_hash": true
            },
            "required": ["coverage_evidence_hash"]
          }
        }
      ]
    },
    "ReconciliationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reconciliation_id",
        "operation_id",
        "attempt_id",
        "client_order_id",
        "state",
        "evidence_sources",
        "checked_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "reconciliation_id": { "$ref": "#/$defs/UUID" },
        "operation_id": { "$ref": "#/$defs/UUID" },
        "attempt_id": { "$ref": "#/$defs/UUID" },
        "client_order_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "state": {
          "enum": [
            "PENDING",
            "ACKNOWLEDGED",
            "REJECTED",
            "NOT_FOUND",
            "MANUAL_RECONCILIATION"
          ]
        },
        "evidence_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CLOID",
              "OID",
              "OPEN_ORDERS",
              "HISTORICAL_ORDERS",
              "FILLS"
            ]
          }
        },
        "exchange_order_id": { "type": "string", "maxLength": 128 },
        "checked_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AgentFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "feedback_id",
        "operation_id",
        "user_id",
        "account_id",
        "rating",
        "comment",
        "include_in_learning",
        "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "feedback_id": { "$ref": "#/$defs/UUID" },
        "operation_id": { "$ref": "#/$defs/UUID" },
        "user_id": { "$ref": "#/$defs/UUID" },
        "account_id": { "$ref": "#/$defs/UUID" },
        "rating": { "type": "integer", "minimum": -2, "maximum": 2 },
        "comment": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "include_in_learning": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AutomationAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authorization_id",
        "grant_id",
        "user_id",
        "account_id",
        "device_id",
        "session_id",
        "risk_policy_version",
        "strategy_version",
        "model_version",
        "review_model_version",
        "allowed_symbols",
        "maximum_notional",
        "authorization_hash",
        "authorized_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "authorization_id": { "$ref": "#/$defs/UUID" },
        "grant_id": { "$ref": "#/$defs/UUID" },
        "user_id": { "$ref": "#/$defs/UUID" },
        "account_id": { "$ref": "#/$defs/UUID" },
        "device_id": { "$ref": "#/$defs/UUID" },
        "session_id": { "$ref": "#/$defs/UUID" },
        "risk_policy_version": { "type": "string", "maxLength": 64 },
        "strategy_version": { "type": "string", "maxLength": 64 },
        "model_version": { "type": "string", "maxLength": 64 },
        "review_model_version": { "type": "string", "maxLength": 64 },
        "allowed_symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Symbol" }
        },
        "maximum_notional": { "$ref": "#/$defs/PositiveDecimal" },
        "authorization_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorized_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "actor_type",
        "subject_type",
        "subject_id",
        "occurred_at",
        "payload_hash"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "event_id": { "$ref": "#/$defs/UUID" },
        "event_type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
        },
        "actor_type": { "enum": ["USER", "DEVICE", "HERMES", "SYSTEM"] },
        "subject_type": {
          "enum": [
            "INTENT",
            "CONFIRMATION",
            "OPERATION",
            "ORDER",
            "POSITION",
            "AUTOMATION_GRANT"
          ]
        },
        "subject_id": { "$ref": "#/$defs/UUID" },
        "occurred_at": { "$ref": "#/$defs/Timestamp" },
        "payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
