          "expected_delay_seconds": 1
        },
        {
          "at_seconds": 0.5,
          "user_id": "USER_A",
          "password_valid": false,
          "expected_decision": "DENY_DELAY",
          "expected_account_failures": 1,
          "expected_source_failures": 1
        },
        {
          "at_seconds": 1,
          "user_id": "USER_A",
          "password_valid": false,
          "expected_decision": "FAILED_DELAY",
          "expected_account_failures": 2,
          "expected_source_failures": 2,
          "expected_delay_seconds": 2
        },
        {
          "at_seconds": 3,
          "user_id": "USER_A",
          "password_valid": false,
          "expected_decision": "FAILED_DELAY",
          "expected_account_failures": 3,
          "expected_source_failures": 3,
          "expected_delay_seconds": 4
        },
        {
          "at_seconds": 7,
          "user_id": "USER_A",
          "password_valid": false,
          "expected_decision": "FAILED_DELAY",
          "expected_account_failures": 4,
          "expected_source_failures": 4,
          "expected_delay_seconds": 8
        },
        {
          "at_seconds": 15,
          "user_id": "USER_A",
          "password_valid": false,
          "expected_decision": "LOCKED",
          "expected_account_failures": 5,
          "expected_source_failures": 5,
          "expected_lock_until_seconds": 915
        },
        {
          "at_seconds": 100,
          "user_id": "USER_A",
          "password_valid": true,
          "expected_decision": "DENY_LOCK",
          "expected_account_failures": 5,
          "expected_source_failures": 5
        },
        {
          "at_seconds": 915,
          "user_id": "USER_A",
          "password_valid": false,
          "expected_decision": "FAILED_DELAY",
          "expected_account_failures": 1,
          "expected_source_failures": 1,
          "expected_delay_seconds": 1
        },
        {
          "at_seconds": 916,
          "user_id": "USER_A",
          "password_valid": false,
          "expected_decision": "FAILED_DELAY",
          "expected_account_failures": 2,
          "expected_source_failures": 2,
          "expected_delay_seconds": 2
        },
        {
          "at_seconds": 916,
          "user_id": "USER_A",
          "password_valid": false,
          "expected_decision": "DENY_DELAY",
          "expected_account_failures": 2,
          "expected_source_failures": 2
        }
      ]
