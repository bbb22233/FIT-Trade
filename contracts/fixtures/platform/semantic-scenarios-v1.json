{
  "schema_version": "fit.platform.semantic-scenarios.v1",
  "challenge_cases": [
    {
      "name": "valid proof strictly before expiry consumes once",
      "synthetic": false,
      "now": "2026-07-29T10:01:59.999Z",
      "expires_at": "2026-07-29T10:02:00Z",
      "already_attempted": false,
      "proof_valid": true,
      "expected": "CONSUMED_SUCCESS"
    },
    {
      "name": "deadline equality is expired",
      "synthetic": false,
      "now": "2026-07-29T10:02:00Z",
      "expires_at": "2026-07-29T10:02:00Z",
      "already_attempted": false,
      "proof_valid": true,
      "expected": "REJECT_EXPIRED"
    },
    {
      "name": "replay after first attempt fails",
      "synthetic": false,
      "now": "2026-07-29T10:01:00Z",
      "expires_at": "2026-07-29T10:02:00Z",
      "already_attempted": true,
      "proof_valid": true,
      "expected": "REJECT_REPLAY"
    },
    {
      "name": "invalid proof consumes the one attempt",
      "synthetic": false,
      "now": "2026-07-29T10:01:00Z",
      "expires_at": "2026-07-29T10:02:00Z",
      "already_attempted": false,
      "proof_valid": false,
      "expected": "CONSUMED_INVALID_PROOF"
    },
    {
      "name": "synthetic challenge has no completion path",
      "synthetic": true,
      "now": "2026-07-29T10:01:00Z",
      "expires_at": "2026-07-29T10:02:00Z",
      "already_attempted": false,
      "proof_valid": true,
      "expected": "REJECT_SYNTHETIC_NO_STATE"
    }
  ],
  "refresh_cases": [
    {
      "name": "active token rotates before both deadlines",
      "status": "ACTIVE",
      "now": "2026-08-01T10:00:00Z",
      "individual_expires_at": "2026-08-05T10:00:00Z",
      "family_deadline": "2026-08-28T10:00:00Z",
      "expected": "ROTATE_CREATE_DESCENDANT"
    },
    {
      "name": "never-rotated individual expiry cannot rotate",
      "status": "ACTIVE",
      "now": "2026-08-05T10:00:00Z",
      "individual_expires_at": "2026-08-05T10:00:00Z",
      "family_deadline": "2026-08-28T10:00:00Z",
      "expected": "REJECT_EXPIRED_NO_ROTATION"
    },
    {
      "name": "rotated ancestor reuse before individual expiry revokes family",
      "status": "ROTATED",
      "now": "2026-08-01T10:00:00Z",
      "individual_expires_at": "2026-08-05T10:00:00Z",
      "family_deadline": "2026-08-28T10:00:00Z",
      "expected": "REVOKE_FAMILY_AND_DESCENDANTS"
    },
    {
      "name": "rotated ancestor reuse after individual expiry still revokes family",
      "status": "ROTATED",
      "now": "2026-08-10T10:00:00Z",
      "individual_expires_at": "2026-08-05T10:00:00Z",
      "family_deadline": "2026-08-28T10:00:00Z",
      "expected": "REVOKE_FAMILY_AND_DESCENDANTS"
    },
    {
      "name": "family deadline wins over reuse",
      "status": "ROTATED",
      "now": "2026-08-28T10:00:00Z",
      "individual_expires_at": "2026-08-29T10:00:00Z",
      "family_deadline": "2026-08-28T10:00:00Z",
      "expected": "REJECT_FAMILY_EXPIRED"
    },
    {
      "name": "revoked descendant always rejects",
      "status": "REVOKED",
      "now": "2026-08-01T10:00:00Z",
      "individual_expires_at": "2026-08-05T10:00:00Z",
      "family_deadline": "2026-08-28T10:00:00Z",
      "expected": "REJECT_REVOKED"
    }
  ],
  "refresh_expiry_cases": [
